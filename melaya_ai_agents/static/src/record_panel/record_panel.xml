<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="melaya_ai_agents.RecordPanel">
        <Dialog title="this.title" size="'md'">
            <div class="o_melaya_panel">
                <p class="text-muted mb-3" t-if="this.state.recordName">
                    <t t-out="this.state.recordName"/>
                </p>

                <div class="alert alert-danger" role="alert" t-if="this.state.error">
                    <t t-out="this.state.error"/>
                </div>
                <div role="status" aria-live="polite">
                    <div class="alert alert-info" t-if="this.state.notice">
                        <t t-out="this.state.notice"/>
                    </div>
                    <div class="alert alert-warning" t-if="this.state.reasonMessage">
                        <t t-out="this.state.reasonMessage"/>
                    </div>
                </div>

                <div t-if="this.state.loading" class="text-muted" role="status">Loading...</div>

                <t t-elif="!this.state.linked">
                    <section class="mb-3">
                        <h5>Link your Melaya account</h5>
                        <p>Link your Melaya account once to ask Melaya about records and run the team's pipelines. A free Melaya account is enough to start.</p>
                        <p class="small text-muted">Linking sends your Odoo login and name to Melaya.</p>
                        <button type="button" class="btn btn-primary me-2" t-att-disabled="this.state.busy" t-on-click="this.onLink">Link your Melaya account</button>
                        <button type="button" class="btn btn-secondary" t-if="this.state.linkOpened" t-att-disabled="this.state.busy" t-on-click="this.onLinkDone">I have linked my account</button>
                    </section>
                </t>

                <t t-else="">
                    <section class="mb-4">
                        <h5>Ask Melaya</h5>
                        <p class="text-muted">Opens the Melaya Assistant in a new tab with a question about this record. Nothing runs until you press Send.</p>
                        <button type="button" class="btn btn-primary" t-att-disabled="this.state.busy || !this.state.canAsk" t-on-click="this.onAsk">Ask Melaya</button>
                    </section>

                    <section class="mb-4">
                        <h5>Run a Melaya pipeline</h5>
                        <p class="text-muted" t-if="!this.state.pipelines.length">No pipeline is available for this kind of record. Ask your administrator to expose one.</p>
                        <t t-else="">
                            <label class="form-label" for="o_melaya_pipeline">Pipeline</label>
                            <select id="o_melaya_pipeline" class="form-select mb-2" t-att-disabled="this.state.busy || !this.state.canRun" t-on-change="this.onPipelineChange">
                                <t t-foreach="this.state.pipelines" t-as="pipeline" t-key="pipeline.id">
                                    <option t-att-value="pipeline.id" t-att-selected="pipeline.id === this.state.pipeline"><t t-out="pipeline.name"/></option>
                                </t>
                            </select>
                            <label class="form-label" for="o_melaya_brief">Brief (optional)</label>
                            <textarea id="o_melaya_brief" class="form-control mb-2" rows="3" t-att-maxlength="this.maxBrief" placeholder="What should the pipeline focus on?" t-att-disabled="!this.state.canRun" t-att-value="this.state.brief" t-on-input="this.onBriefInput"/>
                            <button type="button" class="btn btn-primary" t-att-disabled="this.state.busy || !this.state.pipeline || !this.state.canRun" t-on-click="this.onRun">Run pipeline</button>
                        </t>
                    </section>

                    <section class="mb-3">
                        <h5>Recent runs</h5>
                        <p class="text-muted" t-if="!this.state.runs.length">No runs on this record yet.</p>
                        <ul class="list-unstyled mb-0" t-else="">
                            <li class="d-flex align-items-center justify-content-between border-bottom py-2" t-foreach="this.state.runs" t-as="run" t-key="run.run_id">
                                <div>
                                    <div><t t-out="run.name || run.pipeline"/></div>
                                    <div class="small text-muted"><t t-out="this.formatDate(run.started_at)"/></div>
                                </div>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge" t-att-class="this.isFinished(run.status) ? 'text-bg-light' : 'text-bg-info'"><t t-out="this.statusLabel(run.status)"/></span>
                                    <a t-if="run.url" t-att-href="run.url" target="_blank" rel="noopener noreferrer">Open in Melaya</a>
                                </div>
                            </li>
                        </ul>
                        <p class="small text-muted mt-2" t-if="this.state.pollStopped">Status updates stopped after 30 minutes. Close and open this window again to refresh.</p>
                    </section>

                    <section class="border-top pt-3">
                        <button type="button" class="btn btn-link px-0" t-if="!this.state.confirmUnlink" t-on-click="this.onAskUnlink">Unlink my Melaya account</button>
                        <div t-else="">
                            <p>Unlink your Melaya account from this Odoo user? You leave the Melaya project if you joined it from Odoo.</p>
                            <button type="button" class="btn btn-danger me-2" t-att-disabled="this.state.busy" t-on-click="this.onUnlink">Unlink</button>
                            <button type="button" class="btn btn-secondary" t-on-click="this.onKeepLink">Keep the link</button>
                        </div>
                    </section>
                </t>
            </div>
            <t t-set-slot="footer">
                <button type="button" class="btn btn-secondary" t-on-click="() => this.props.close()">Close</button>
            </t>
        </Dialog>
    </t>

</templates>
