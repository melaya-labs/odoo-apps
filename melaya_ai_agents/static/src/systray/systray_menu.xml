<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="melaya_ai_agents.Systray">
        <Dropdown t-if="this.state.enabled" position="'bottom-end'" state="this.dropdown"
                  beforeOpen.bind="this.onBeforeOpen" menuClass="'o_melaya_systray_menu p-0'" bottomSheet="false">
            <button type="button" class="o_melaya_systray_toggler" t-att-title="this.togglerLabel" t-att-aria-label="this.togglerLabel">
                <img src="/melaya_ai_agents/static/description/icon.png" alt="" class="o_melaya_logo" width="18" height="18"/>
                <span t-if="this.state.approvalCount" class="badge rounded-pill text-bg-warning" aria-hidden="true"><t t-out="this.state.approvalCount"/></span>
            </button>
            <t t-set-slot="content">
                <div class="o_melaya_systray">
                    <div class="d-flex align-items-center justify-content-between gap-3 px-3 py-2 border-bottom">
                        <span class="fw-bold">Your Melaya runs</span>
                        <span t-if="this.state.approvalCount" class="small text-warning-emphasis text-nowrap"><t t-out="this.waitingLabel"/></span>
                    </div>
                    <div t-if="!this.state.loaded" class="text-muted px-3 py-3" role="status">Loading...</div>
                    <div t-elif="this.state.error and !this.state.runs.length" class="text-muted px-3 py-3" role="status">Your runs could not be loaded. Try again in a moment.</div>
                    <div t-elif="!this.state.runs.length" class="text-muted px-3 py-3">No runs yet. Open a record, click Melaya and run a pipeline.</div>
                    <ul t-else="" class="list-group list-group-flush mb-0">
                        <li t-foreach="this.state.runs" t-as="run" t-key="run.id" class="list-group-item bg-transparent d-flex align-items-start justify-content-between gap-2 px-3 py-2">
                            <div class="o_melaya_systray_main">
                                <div class="fw-semibold text-truncate" t-att-title="run.pipeline_name"><t t-out="run.pipeline_name"/></div>
                                <a href="#" class="small d-block text-truncate" t-att-title="run.record_name" t-on-click.prevent="() => this.openRecord(run)"><t t-out="run.record_name or run.model"/></a>
                            </div>
                            <div class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
                                <span class="badge" t-att-class="this.badgeClass(run)"><t t-out="this.statusLabel(run)"/></span>
                                <a t-if="run.url" t-att-href="run.url" class="small text-nowrap" target="_blank" rel="noopener noreferrer">Open in Melaya</a>
                            </div>
                        </li>
                    </ul>
                </div>
            </t>
        </Dropdown>
    </t>

</templates>
