<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="melaya_diagnostics_view_form" model="ir.ui.view">
        <field name="name">melaya.diagnostics.form</field>
        <field name="model">melaya.diagnostics</field>
        <field name="arch" type="xml">
            <form string="Melaya diagnostics">
                <div class="alert alert-warning" role="alert" invisible="not error">
                    <field name="error" readonly="1"/>
                </div>
                <group>
                    <group string="Odoo">
                        <field name="connected"/>
                        <field name="api_url"/>
                        <field name="database_uuid"/>
                        <field name="token_database_uuid"/>
                        <field name="odoo_version"/>
                        <field name="local_last_error"/>
                    </group>
                    <group string="Melaya">
                        <field name="project"/>
                        <field name="owner"/>
                        <field name="seats"/>
                        <field name="last_seen_at"/>
                        <field name="server_last_error"/>
                        <field name="clock_offset"/>
                    </group>
                </group>
                <footer>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_melaya_diagnostics" model="ir.actions.act_window">
        <field name="name">Melaya diagnostics</field>
        <field name="res_model">melaya.diagnostics</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
